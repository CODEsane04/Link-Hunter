{
    "manifest_version": 3,
    "name": "Link Hunter",
    "version": "1.0",
    "description": "AI-first chrome extenssion, to get you tutorial video links based on your images",
    "permissions": [
        "activeTab",
        "contextMenus",
        "storage"
    ],
    "host_permissions": [
        "http://localhost:8000/*",
        "https://link-hunter-backend.onrender.com/*"
    ],
    "background": {
        "service_worker": "service-worker.js"
    },
    "action": {
        "default_popup": "vps.html",
        "default_title": "My First Extension",
        "default_icon": {
            "16": "icons/lhicon16.png",
            "32": "icons/lhicon32.png",
            "48": "icons/lhicon48.png",
            "128": "icons/lhicon128.png"
        }
    },
    "icons": {
        "16": "icons/lhicon16.png",
        "32": "icons/lhicon32.png",
        "48": "icons/lhicon48.png",
        "128": "icons/lhicon128.png"
    }
}